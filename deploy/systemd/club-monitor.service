[Unit]
Description=Club local readiness and resource checks
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/club
Environment=ENV_FILE=/etc/club/compose.env
EnvironmentFile=-/etc/club/operations.env
ExecStart=/bin/bash /opt/club/scripts/monitor.sh
UMask=0077
TimeoutStartSec=2min
